# QLever Docker Stack Environment Variables
# Copy this file to .env and customize for your deployment

# QLever Service Configuration
QLEVER_PORT=7001
QLEVER_MEMORY_FOR_QUERIES=30G
QLEVER_CACHE_MAX_SIZE=10G

# QLever UI Configuration
QLEVER_UI_PORT=7000
QLEVER_BACKEND_URL=http://qlever:7001

# Data Storage Paths
# These directories must exist before deploying the stack
QLEVER_INDEX_PATH=/data/qlever/index
QLEVER_CACHE_PATH=/data/qlever/cache

# Resource Limits
CPU_LIMIT=4
MEMORY_LIMIT=32G
CPU_RESERVATION=2
MEMORY_RESERVATION=16G

# Deployment Configuration
REPLICAS=1
